        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(game_net_pool_failures[1m]))",
          "legendFormat": "refusals/sec",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": [
          {
            "matcher": { "id": "byFrameRefID", "options": "B" },
            "properties": [
              { "id": "unit", "value": "reqps" },
              { "id": "custom.axisPlacement", "value": "right" }
            ]
          }
        ]
      }
